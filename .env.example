# SQLite database file. Created by `npm run db:push`.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use 32+ random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. Get a free key at https://aistudio.google.com/apikey
# Without it, diet and workout plans still generate using the
# deterministic fallback. Only natural-language food entry needs it.
GEMINI_API_KEY=""
